# ---------------------------------------------------------------
# EletroKanban - variáveis de ambiente para deploy
# Copie para .env e ajuste antes de rodar docker compose up
# ---------------------------------------------------------------

# ----- Django -----
# Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DJANGO_DEBUG=False

# Hosts aceitos pelo Django. Em produção, use o domínio publico.
# Exemplo: kanban.suaempresa.com.br,www.kanban.suaempresa.com.br
DJANGO_ALLOWED_HOSTS=*

# Origens permitidas para CORS e CSRF.
# Em produção, use https://SEU_DOMINIO (com protocolo).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# Cookies seguros: mude para True quando publicar em HTTPS.
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# ----- PostgreSQL -----
POSTGRES_DB=eletrokanban
POSTGRES_USER=eletrokanban
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_PORT=5432

# ----- Portas publicadas -----
# Porta do frontend (nginx) acessivel externamente.
FRONTEND_PORT=8080
# Porta do backend exposta (opcional; util para depuracao).
BACKEND_PORT_PUBLIC=8000

# ----- Gunicorn -----
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# ----- Frontend -----
# URL usada pelo build do Vite para acessar a API.
# "/api" faz o nginx encaminhar ao backend. Em deploy com dominio
# e HTTPS, pode ser https://SEU_DOMINIO/api.
VITE_API_URL=/api
